{
  "manifest_version": 2,
  "name": "SimPrinter - SimBrief Performance Print",
  "version": "1.0.0",
  "description": "Adds a Print button to SimBrief's Takeoff/Landing Performance calculator that sends the result straight to SimPrinter.",
  "permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["*://dispatch.simbrief.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "simprinter-performance-print@simprinter.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
